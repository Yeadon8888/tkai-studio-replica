{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "VIDEO-HITL-decision-v1",
  "title": "视频 Human-in-the-loop 决定（改编自 POD-HITL-feedback-v1）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "gate", "decision", "project", "take", "reason", "reviewer", "decided_at"],
  "properties": {
    "schema_version": {"const": "VIDEO-HITL-decision-v1"},
    "decision_id": {"type": "string", "pattern": "^VHITL-[0-9]{8}-[A-Za-z0-9_-]+$"},
    "gate": {"enum": ["H0", "H1", "H2", "H3", "H4"]},
    "decision": {"enum": ["accept", "iterate", "redo", "hold", "abandon", "release"]},
    "project": {"type": "string", "minLength": 1},
    "take": {"type": "string", "minLength": 1},
    "brief": {"type": ["string", "null"]},
    "expert_decision": {"enum": ["pass", "repair", "escalate", null]},
    "carry_forward_features": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "must_change_features": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "must_not_repeat": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reason": {"type": "string", "minLength": 8},
    "reviewer": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"},
    "candidate_rule_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposal", "proposed_scope", "status"],
        "properties": {
          "proposal": {"type": "string", "minLength": 1},
          "proposed_scope": {"enum": ["direction", "benchmark", "product", "expert_prompt", "rubric", "global"]},
          "status": {"const": "candidate"}
        }
      }
    }
  }
}
