CONFIG_VERSION=1
STUDIO_HOME=
CREDENTIALS_FILES=~/.config/tokensfactory/credentials.env,~/.config/tikhub/credentials.env

MODEL_TEXT=gemini-4-hydrogen
MODEL_SCRIPT=
MODEL_REVIEW=
MODEL_VIDEO=minimax-H3
MODEL_IMAGE=gpt-image-2
MODEL_TTS=gemini-3.8-flash-tts
# 视频理解体检同时验证已知正常模型和退化对照模型，逗号分隔。
MODEL_VIDEO_READ_PROBE=gemini-4-hydrogen,gemini-3.8-flash-low
PROBE_MAX_TOKENS=3000
AUDIO_ROUTE_DEFAULT=auto
# 自动选模白名单；留空表示目录中全部 policy=allowed 的模型。
MODELS_ALLOWED=
# 简报用 video_route 选择用途；MODEL_VIDEO 仅兼容旧配置。
VIDEO_ROUTE_DEFAULT=minimax-H3
VIDEO_ROUTE_QUALITY=minimax-H3-cinema
VIDEO_ROUTE_FAST=minimax-H3-fast
VIDEO_ROUTE_KEYFRAME=minimax-H3-first-last
VIDEO_ROUTE_REPLACE_PERSON=minimax_h3_zm_titi
VIDEO_ROUTE_MOTION=wan2.2-motion
# 人民币元/请求秒；未知价格的模型不要填，账本金额保持 null。
VIDEO_PRICES={"minimax-H3":{"768p":0.13},"minimax-H3-cinema":{"480p":0.10,"768p":0.13,"960p":0.23},"minimax-H3-fast":{"480p":0.10,"768p":0.13},"minimax-H3-first-last":{"480p":0.10,"768p":0.13},"minimax_h3_zm_titi":{"768p":0.25}}
VIDEO_PRICE_CNY_PER_SECOND=0.13
# 单张图片估价（元）；不确定时留空，账本金额记为未知。
IMAGE_PRICE_CNY=

LIMIT_TEXT_CALLS=100
PRODUCT_BUDGET_CNY=5
# 预计金额同时不超过此值和品剩余预算时，预算节点自动批准；0 表示永不自动批准。
AUTO_APPROVE_CNY=0
MAX_ATTEMPTS=3
# 旧名 REFINE_MAX_ATTEMPTS 仅作读取兼容；新配置统一写 MAX_ATTEMPTS。
REVIEW_MAX_TOKENS=6000
# 带视频的请求里，视频至少占多少 token 才算真的读到（防止模型没看视频却编出结论）
VIDEO_MIN_TOKENS=150

# github_temp：评审本地视频时临时上传，结束后删除；off：无可用 remote_url 时回退抽帧。
MEDIA_UPLOAD=github_temp
MEDIA_HOST_REPO=
