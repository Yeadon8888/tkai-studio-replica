# studio-replica 配置。复制为 .env 后按需修改：  cp .env.example .env
# 优先级：进程环境变量 > .env > 代码默认值（kit/settings.py）。.env 不进仓库。
CONFIG_VERSION=1

# ── 密钥 ─────────────────────────────────────────────
# 推荐：不把密钥写在这里，只列出密钥文件的路径（逗号分隔）。文件里需要有
#   TOKENSFACTORY_API_KEY=...   与   TIKHUB_API_KEY=...
CREDENTIALS_FILES=~/.config/tokensfactory/credentials.env,~/.config/tikhub/credentials.env
# 也可以直接写在这里（本文件已被 .gitignore 排除）：
# TOKENSFACTORY_API_KEY=
# TIKHUB_API_KEY=

# ── 供应方与地址 ─────────────────────────────────────
TEXT_PROVIDER=tokensfactory
VIDEO_PROVIDER=tokensfactory
TOKENSFACTORY_BASE_URL=https://tokensfactory.cc
TIKHUB_BASE_URL=https://api.tikhub.io

# ── 模型（换模型只改这里）────────────────────────────
# MODEL_TEXT 是默认的文本/视频理解模型。下面各环节留空 = 沿用 MODEL_TEXT。
MODEL_TEXT=gemini-3.8-flash
MODEL_VERIFY=
MODEL_BREAKDOWN=
MODEL_DRAFT=
MODEL_CRITIC=
MODEL_REVIEW=
MODEL_REVISE=
# 视频生成模型与单价（元/秒）。换模型时两项一起改。
MODEL_VIDEO=minimax-H3
VIDEO_PRICE_CNY_PER_SECOND=0.13
VIDEO_DURATION=10
VIDEO_RESOLUTION=768p
VIDEO_ASPECT=9:16

# ── 上限与预算 ───────────────────────────────────────
LIMIT_TIKHUB_CALLS=100
LIMIT_TEXT_CALLS=100
PRODUCT_BUDGET_CNY=5
TIER_WEIGHTS=H:4,M:3,L:2,X:1
FISSION_MAX_N=5
REFINE_MAX_ATTEMPTS=3
REVIEW_FRAMES=8

# ── 路径 ─────────────────────────────────────────────
# 数据目录（products/、projects/、ledger/）。留空 = skill 根目录。
STUDIO_HOME=
BOARD_RESEARCH=research/tiktok-benchmark/20261111-loop-test-A
